# ============================================================================
# Traced environment variables.
#
# Place a copy at the project root named `.env` for docker-compose + core-service.
# The frontend reads its own `.env.local` in `frontend/`; copy the NEXT_PUBLIC_*
# section there.
# The intelligence-service reads `.env` from `backend/intelligence-service/`;
# copy the OPENAI / NCBI / NHS / DATABASE_URL section there.
# ============================================================================

# ---- Postgres (docker-compose + core-service) ----
POSTGRES_DB=traced
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# ---- Redis (docker-compose + core-service) ----
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ---- Spring auth (core-service) ----
# JWT_SECRET must be at least 32 bytes for HS256.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ---- Service wiring (core-service) ----
INTELLIGENCE_SERVICE_URL=http://localhost:8000

# ---- Intelligence-service (backend/intelligence-service/.env) ----
# Pydantic BaseSettings auto-maps uppercase env → lowercase attributes.
OPENAI_API_KEY=
NCBI_API_KEY=
NHS_API_KEY=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_BASE_URL=http://localhost:8080

# ---- Frontend (frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8080
# Supabase (community chat is deferred in v1 but env var stays).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Web-push VAPID key (Sprint 27). Generate with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
